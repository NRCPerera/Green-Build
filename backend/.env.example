# Green Build Backend Environment Configuration
# Copy this file to .env and modify as needed

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/greenbuild
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/greenbuild
MONGODB_URI=mongodb+srv://tisharaprabashvara22:Greenbuild@cluster0.qtq3agg.mongodb.net/greenbuild?retryWrites=true&w=majority&appName=Cluster0

# Python ML Service URL (Quantity Takeoff)
PYTHON_SERVICE_URL=http://localhost:8000

# Cost Overrun Prediction ML Service URL
COST_ML_SERVICE_URL=http://localhost:8085

# Delay Prediction ML Service URL
DELAY_ML_SERVICE_URL=http://localhost:8081

# FRED Economic Indicator API
FRED_BASE_URL=https://api.stlouisfed.org/fred
# Use your own API key in backend/.env (not in this example file)
FRED_API_KEY=your-fred-api-key
FRED_SERIES_INFLATION=FPCPITOTLZGLKA
FRED_SERIES_EXCHANGE_LKR=EXSLUS
FRED_SERIES_MATERIAL_INDEX=DDOE01LKA086NWDB
ECONOMIC_API_TIMEOUT_MS=15000
ECONOMIC_CACHE_TTL_SECONDS=3600

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Upload Directory
UPLOAD_DIR=./uploads

# JWT Authentication
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

