# Green Build Backend Environment Configuration
# Copy this file to .env and modify as needed

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/greenbuild
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/greenbuild
MONGODB_URI=mongodb://localhost:27017/greenbuild

# Python ML Service URL (Quantity Takeoff)
PYTHON_SERVICE_URL=http://localhost:8000

# Cost Overrun Prediction ML Service URL
COST_ML_SERVICE_URL=http://localhost:8001

# Delay Prediction ML Service URL
DELAY_ML_SERVICE_URL=http://localhost:8081

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Upload Directory
UPLOAD_DIR=./uploads

# JWT Authentication
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

