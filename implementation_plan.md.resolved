## 5. Rate Engine — Pseudocode

### File: `backend/services/rateEngine.js` (NEW)

```javascript
/**
 * Rate Engine Service
 *
 * Resolves the correct rate for a BOQ item based on:
 *   1. Section (earthworks, finishes, etc.)
 *   2. Item code (A01, D05, etc.)
 *   3. Material type (standard, premium, ceramic, etc.)
 *   4. Effective date (latest rate where effective_date <= target_date)
 *
 * Falls back to config.costRates if no DB rate exists (backward compat).
 */

const Rate = require('../models/Rate');
const config = require('../config');

// ── Cache (optional, in-memory TTL) ─────────────────────
let rateCache = {};
let cacheTimestamp = 0;
const CACHE_TTL = 5 * 60 * 1000; // 5 minutes

/**
 * Get the effective rate for a specific item.
 *
 * @param {string} section     — e.g. 'finishes'
 * @param {string} itemCode    — e.g. 'D05'
 * @param {string} materialType — e.g. 'ceramic' (default: 'standard')
 * @param {Date}   asOfDate    — rate effective on this date (default: now)
 * @returns {Object} { rate, rateId, effectiveDate, unit, source }
 */
async function getRate(section, itemCode, materialType = 'standard', asOfDate = new Date()) {
    // 1. Try DB lookup — latest rate where effectiveDate <= asOfDate
    const dbRate = await Rate.findOne({
        section,
        itemCode,
        materialType,
        effectiveDate: { $lte: asOfDate },
        isActive: true
    })
    .sort({ effectiveDate: -1 })   // newest first
    .lean();

    if (dbRate) {
        return {
            rate: dbRate.rate,
            rateId: dbRate._id,
            effectiveDate: dbRate.effectiveDate,
            unit: dbRate.unit,
            source: 'database',
            itemName: dbRate.itemName
        };
    }

    // 2. Fallback to config defaults (backward compatibility)
    const fallbackRate = getFallbackRate(section, itemCode);
    return {
        rate: fallbackRate.rate,
        rateId: null,
        effectiveDate: null,
        unit: fallbackRate.unit,
        source: 'config_default',
        itemName: fallbackRate.itemName
    };
}

/**
 * Get all rates for a section (for frontend material selection UI).
 */
async function getRatesForSection(section, asOfDate = new Date()) {
    const rates = await Rate.aggregate([
        {
            $match: {
                section,
                effectiveDate: { $lte: asOfDate },
                isActive: true
            }
        },
        { $sort: { effectiveDate: -1 } },
        {
            $group: {
                _id: { itemCode: '$itemCode', materialType: '$materialType' },
                latestRate: { $first: '$$ROOT' }
            }
        },
        { $replaceRoot: { newRoot: '$latestRate' } },
        { $sort: { itemCode: 1, materialType: 1 } }
    ]);

    return rates;
}

/**
 * Import rates from parsed CSV rows.
 * Creates new rate entries (preserving old ones for history).
 */
async function importFromCSV(rows, uploadedBy) {
    const results = { imported: 0, skipped: 0, errors: [] };

    for (const row of rows) {
        try {
            // Validate required fields
            if (!row.section || !row.itemCode || !row.rate) {
                results.skipped++;
                continue;
            }

            await Rate.create({
                section: row.section,
                itemCode: row.itemCode.toUpperCase(),
                itemName: row.itemName || row.itemCode,
                description: row.description || '',
                unit: row.unit || 'No.',
                materialType: row.materialType || 'standard',
                rate: parseFloat(row.rate),
                effectiveDate: row.effectiveDate
                    ? new Date(row.effectiveDate)
                    : new Date(),
                source: 'csv_import',
                uploadedBy
            });

            results.imported++;
        } catch (err) {
            results.errors.push({
                row: row.itemCode,
                error: err.message
            });
        }
    }

    return results;
}

// ── Fallback rates from config (backward compat) ────────
function getFallbackRate(section, itemCode) {
    const FALLBACK_MAP = {
        'earthworks': {
            'A01': { rate: 250, unit: 'm²', itemName: 'Site Clearance' },
            'A02': { rate: 2800, unit: 'm³', itemName: 'Excavation' },
            'A03': { rate: 1800, unit: 'm³', itemName: 'Backfilling' },
            'A04': { rate: 600, unit: 'm²', itemName: 'Compaction' },
            'A05': { rate: 3200, unit: 'm³', itemName: 'Surplus Disposal' },
        },
        'concrete_works': {
            'B01': { rate: 12000, unit: 'm³', itemName: 'PCC' },
            'B02': { rate: 22000, unit: 'm³', itemName: 'RCC' },
            'B03': { rate: 1200, unit: 'm²', itemName: 'Formwork' },
            'B04': { rate: 260, unit: 'kg', itemName: 'Reinforcement Steel' },
        },
        'masonry_works': {
            'C01': { rate: 5500, unit: 'm²', itemName: 'Brickwork' },
            'C02': { rate: 4800, unit: 'm²', itemName: 'Blockwork' },
            'C03': { rate: 8500, unit: 'm³', itemName: 'Stone Masonry' },
        },
        'finishes': {
            'D01': { rate: config.costRates.wallPlasterRatePerSqm, unit: 'm²', itemName: 'Plastering' },
            'D02': { rate: config.costRates.wallPaintRatePerSqm, unit: 'm²', itemName: 'Wall Painting' },
            'D03': { rate: config.costRates.wallTilingRatePerSqm, unit: 'm²', itemName: 'Wall Tiling' },
            'D04': { rate: 3500, unit: 'm²', itemName: 'Floor Tiling' },
            'D05': { rate: 8500, unit: 'm²', itemName: 'Wood Flooring' },
            'D06': { rate: 2500, unit: 'm²', itemName: 'Carpet Flooring' },
            'D07': { rate: 1200, unit: 'm²', itemName: 'Plain Ceiling' },
            'D08': { rate: 3500, unit: 'm²', itemName: 'False Ceiling' },
        },
        'doors_windows': {
            'E01': { rate: config.costRates.doorUnitCost, unit: 'No.', itemName: 'Wooden Doors' },
            'E02': { rate: config.costRates.windowUnitCost, unit: 'No.', itemName: 'Aluminium Windows' },
            'E03': { rate: 8500, unit: 'm²', itemName: 'Glass Installation' },
            'E04': { rate: 5000, unit: 'set', itemName: 'Ironmongery' },
        },
        'mep_works': {
            'F01': { rate: 1800, unit: 'm', itemName: 'Electrical Wiring' },
            'F02': { rate: 3500, unit: 'No.', itemName: 'Lighting Fixtures' },
            'F03': { rate: 8500, unit: 'No.', itemName: 'Switchboards' },
            'F04': { rate: 1500, unit: 'No.', itemName: 'Electrical Outlets' },
            'F05': { rate: 1200, unit: 'No.', itemName: 'Switches' },
            'F06': { rate: 150000, unit: 'No.', itemName: 'AC Units' },
            'F07': { rate: 950, unit: 'm', itemName: 'Plumbing Pipes' },
            'F08': { rate: 2500, unit: 'No.', itemName: 'Plumbing Fittings' },
            'F09': { rate: 15000, unit: 'No.', itemName: 'Sinks' },
            'F10': { rate: 35000, unit: 'No.', itemName: 'Toilets' },
            'F11': { rate: 25000, unit: 'No.', itemName: 'Showers' },
            'F12': { rate: 85000, unit: 'No.', itemName: 'Bathtubs' },
            'F13': { rate: 350000, unit: 'No.', itemName: 'Staircases' },
        }
    };

    return FALLBACK_MAP[section]?.[itemCode]
        || { rate: 0, unit: '?', itemName: itemCode };
}

module.exports = {
    getRate,
    getRatesForSection,
    importFromCSV,
    getFallbackRate
};
