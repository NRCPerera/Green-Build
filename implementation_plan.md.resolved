## 6. BOQ Generation — Pseudocode

### File: `backend/services/boqGenerator.js` (NEW)

```javascript
/**
 * BOQ Generator Service
 *
 * Takes confirmed detections + user inputs + dynamic rates
 * and produces a complete BOQ with Sections A–F.
 *
 * Called by: POST /api/boq/generate
 */

const rateEngine = require('./rateEngine');

/**
 * Generate a complete BOQ.
 *
 * @param {Object} confirmed   — confirmedDetections from FloorPlan
 * @param {Object} materials   — materialSelections from user
 * @param {Date}   rateDate    — effective date for rate lookup
 * @returns {Object} { sections[], summary }
 */
async function generateBOQ(confirmed, materials = {}, rateDate = new Date()) {
    const sections = [];

    // ── Section A: Earthworks ─────────────────────────────
    const earthworks = await buildSection('A', 'Earthworks', 'earthworks', [
        {
            code: 'A01', qty: confirmed.rooms_total_area,
            material: 'standard'
        },
        {
            code: 'A02', qty: confirmed.rooms_total_area * (confirmed.additional?.excavationDepth || 1.2),
            material: 'standard'
        },
        {
            code: 'A03', qty: confirmed.rooms_total_area * (confirmed.additional?.excavationDepth || 1.2) * 0.7,
            material: 'standard'
        },
        {
            code: 'A04', qty: confirmed.rooms_total_area,
            material: 'standard'
        },
        {
            code: 'A05', qty: confirmed.rooms_total_area * (confirmed.additional?.excavationDepth || 1.2) * 0.3,
            material: 'standard'
        },
    ], rateDate);
    sections.push(earthworks);

    // ── Section B: Concrete Works ─────────────────────────
    const floorArea = confirmed.rooms_total_area || 0;
    const concrete = await buildSection('B', 'Concrete Works', 'concrete_works', [
        { code: 'B01', qty: floorArea * 0.075, material: 'standard' }, // PCC
        { code: 'B02', qty: floorArea * 0.30, material: 'standard' },  // RCC
        { code: 'B03', qty: floorArea * 0.80, material: 'standard' },  // Formwork
        { code: 'B04', qty: floorArea * 0.30 * 78, material: 'standard' }, // Steel
    ], rateDate);
    sections.push(concrete);

    // ── Section C: Masonry Works ──────────────────────────
    const wallArea = confirmed.walls?.netArea || 0;
    const masonry = await buildSection('C', 'Masonry Works', 'masonry_works', [
        { code: 'C02', qty: wallArea, material: materials.masonryType || 'standard' },
    ], rateDate);
    sections.push(masonry);

    // ── Section D: Finishes ──────────────────────────────
    const finishItems = [];
    finishItems.push({ code: 'D01', qty: wallArea * 2, material: 'standard' }); // Plaster
    finishItems.push({ code: 'D02', qty: wallArea * 2, material: 'standard' }); // Painting

    // Per-room flooring based on user material selection
    for (const room of (confirmed.rooms || [])) {
        const material = room.flooringMaterial || materials.flooringDefault || 'ceramic_tile';
        const flooringCode = material.includes('wood') ? 'D05' :
                             material.includes('carpet') ? 'D06' : 'D04';
        finishItems.push({ code: flooringCode, qty: room.area, material });
    }

    // Ceiling per room
    for (const room of (confirmed.rooms || [])) {
        const ceilingCode = room.ceilingType === 'false' ? 'D08' : 'D07';
        finishItems.push({ code: ceilingCode, qty: room.area, material: 'standard' });
    }

    sections.push(await buildSection('D', 'Finishes', 'finishes', finishItems, rateDate));

    // ── Section E: Doors & Windows ───────────────────────
    const dwItems = [];
    const approvedDoors = (confirmed.doors || []).filter(d => d.status !== 'deleted');
    const approvedWindows = (confirmed.windows || []).filter(w => w.status !== 'deleted');

    if (approvedDoors.length > 0) {
        dwItems.push({ code: 'E01', qty: approvedDoors.length, material: materials.doorType || 'standard' });
        dwItems.push({ code: 'E04', qty: approvedDoors.length, material: 'standard' }); // Ironmongery
    }
    if (approvedWindows.length > 0) {
        dwItems.push({ code: 'E02', qty: approvedWindows.length, material: materials.windowType || 'standard' });
    }

    sections.push(await buildSection('E', 'Doors & Windows', 'doors_windows', dwItems, rateDate));

    // ── Section F: MEP Works ─────────────────────────────
    const add = confirmed.additionalInputs || {};
    const mepItems = [];
    if (floorArea > 0) mepItems.push({ code: 'F01', qty: floorArea * 1.5, material: 'standard' }); // Wiring
    if (add.lightFixtures) mepItems.push({ code: 'F02', qty: add.lightFixtures, material: 'standard' });
    if (add.switchboards) mepItems.push({ code: 'F03', qty: add.switchboards, material: 'standard' });
    if (add.outlets) mepItems.push({ code: 'F04', qty: add.outlets, material: 'standard' });
    if (add.switches) mepItems.push({ code: 'F05', qty: add.switches, material: 'standard' });
    if (add.acUnits) mepItems.push({ code: 'F06', qty: add.acUnits, material: 'standard' });
    if (add.plumbingPipeLength) mepItems.push({ code: 'F07', qty: add.plumbingPipeLength, material: 'standard' });
    if (add.sinks) mepItems.push({ code: 'F09', qty: add.sinks, material: 'standard' });
    if (add.toilets) mepItems.push({ code: 'F10', qty: add.toilets, material: 'standard' });
    if (add.showers) mepItems.push({ code: 'F11', qty: add.showers, material: 'standard' });
    if (add.bathtubs) mepItems.push({ code: 'F12', qty: add.bathtubs, material: 'standard' });
    if (add.staircases) mepItems.push({ code: 'F13', qty: add.staircases, material: 'standard' });

    sections.push(await buildSection('F', 'MEP Works', 'mep_works', mepItems, rateDate));

    // ── Summary ──────────────────────────────────────────
    const subtotal = sections.reduce((sum, s) => sum + s.subtotal, 0);
    const contingency = subtotal * 0.10;
    const overhead = subtotal * 0.15;
    const profit = subtotal * 0.10;

    return {
        sections,
        summary: {
            sectionSubtotals: Object.fromEntries(
                sections.map(s => [s.sectionKey, s.subtotal])
            ),
            subtotal,
            contingencyPercent: 10,
            contingencyAmount: contingency,
            overheadPercent: 15,
            overheadAmount: overhead,
            profitPercent: 10,
            profitAmount: profit,
            grandTotal: subtotal + contingency + overhead + profit,
            currency: 'LKR',
            rateDate
        }
    };
}

/**
 * Build a single BOQ section by looking up rates for each item.
 */
async function buildSection(code, title, sectionKey, items, rateDate) {
    const resolvedItems = [];

    for (const item of items) {
        if (!item.qty || item.qty <= 0) continue;

        const rateInfo = await rateEngine.getRate(sectionKey, item.code, item.material, rateDate);
        const amount = item.qty * rateInfo.rate;

        resolvedItems.push({
            itemNo: item.code,
            section: sectionKey,
            itemName: rateInfo.itemName,
            description: rateInfo.itemName,
            unit: rateInfo.unit,
            quantity: parseFloat(item.qty.toFixed(2)),
            materialType: item.material,
            rate: rateInfo.rate,
            rateRef: rateInfo.rateId,
            rateEffectiveDate: rateInfo.effectiveDate,
            amount: parseFloat(amount.toFixed(2)),
            source: rateInfo.source === 'database' ? 'calculated' : 'ml-detected'
        });
    }

    const subtotal = resolvedItems.reduce((sum, i) => sum + i.amount, 0);

    return {
        code,
        title,
        sectionKey,
        items: resolvedItems,
        subtotal: parseFloat(subtotal.toFixed(2))
    };
}

module.exports = { generateBOQ };
```

