## 2. Database Modifications

### 2.1 NEW Collection: `rates`

> [!IMPORTANT]
> This is the ONLY new collection required. All other changes are schema modifications to existing collections.

```javascript
// backend/models/Rate.js — NEW FILE

const rateSchema = new mongoose.Schema({
    // ── Identity ──────────────────────────────────
    section: {
        type: String,
        required: true,
        enum: [
            'earthworks',        // A
            'concrete_works',    // B
            'masonry_works',     // C
            'finishes',          // D
            'doors_windows',     // E
            'mep_works'          // F
        ]
    },
    itemCode: {
        type: String,
        required: true,
        uppercase: true,
        trim: true
        // e.g. "A01", "B03", "D05", "F12"
    },
    itemName: {
        type: String,
        required: true,
        trim: true
        // e.g. "Site Clearance", "RCC Grade 25"
    },
    description: {
        type: String,
        trim: true
    },

    // ── Pricing ───────────────────────────────────
    unit: {
        type: String,
        required: true
        // m², m³, kg, No., m, set, lot
    },
    materialType: {
        type: String,
        default: 'standard'
        // e.g. "standard", "premium", "economy",
        // or material name like "ceramic", "porcelain", "granite"
    },
    rate: {
        type: Number,
        required: true,
        min: 0
    },
    currency: {
        type: String,
        default: 'LKR'
    },

    // ── Versioning ────────────────────────────────
    effectiveDate: {
        type: Date,
        required: true,
        default: Date.now
    },
    expiryDate: {
        type: Date  // null = currently active
    },
    version: {
        type: Number,
        default: 1
    },

    // ── Audit ─────────────────────────────────────
    uploadedBy: {
        type: mongoose.Schema.Types.ObjectId,
        ref: 'User'
    },
    source: {
        type: String,
        enum: ['manual', 'csv_import', 'system_default'],
        default: 'manual'
    },
    isActive: {
        type: Boolean,
        default: true
    }
}, {
    timestamps: true
});

// Compound index for rate lookups
rateSchema.index({ section: 1, itemCode: 1, materialType: 1, effectiveDate: -1 });
rateSchema.index({ isActive: 1, effectiveDate: -1 });
```

